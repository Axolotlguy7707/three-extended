{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,

    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,

    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src"]
}